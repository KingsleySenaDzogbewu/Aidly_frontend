VITE_API_BASE_URL=https://driving-school-backend-1hjt.onrender.com/api/v1

# Sentry error tracking + the in-app "Report a Bug" feedback widget.
# Not a secret - Sentry's DSN is a public write key meant to ship in client
# code. Leave unset to run with Sentry disabled (e.g. local dev).
VITE_SENTRY_DSN=
